VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The deployed site URL — magic-link emails always redirect here, never to
# wherever the request happened to be sent from. Leave unset locally (falls
# back to window.location.origin, i.e. localhost) but set it in Vercel's
# env vars for the production deployment.
VITE_SITE_URL=https://stradde-pro.vercel.app
